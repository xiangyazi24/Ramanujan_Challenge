def gaugeRow0 (v : ℕ → ℚ) (n : ℕ) : ℚ :=
  gaugeR00 n * v (n + 2) + gaugeR01 n * v (n + 1) + gaugeR02 n * v n

def gaugeRow1 (v : ℕ → ℚ) (n : ℕ) : ℚ :=
  gaugeR10 n * v (n + 2) + gaugeR11 n * v (n + 1) + gaugeR12 n * v n

def gaugeRow2 (v : ℕ → ℚ) (n : ℕ) : ℚ :=
  gaugeR20 n * v (n + 2) + gaugeR21 n * v (n + 1) + gaugeR22 n * v n

theorem ZudilinSatisfiesRec.step {v : ℕ → ℚ}
    (hv : ZudilinSatisfiesRec v) (n : ℕ) :
    v (n + 3) =
      zAlpha n * v (n + 2) + zBeta n * v (n + 1) + zGamma n * v n := by
  rw [hv n]
  simp only [zAlpha, zBeta, zGamma, sub_eq_add_neg]
  ring

/-- The marked Zudilin denominator is at least one and nondecreasing.  This is
proved directly from its exact recurrence, independently of any asymptotic
input. -/
theorem zudilinB_one_le_and_le_succ (n : ℕ) :
    1 ≤ zudilinB n ∧ zudilinB n ≤ zudilinB (n + 1) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
      match n with
      | 0 => norm_num [zudilinB, zudilinSolution]
      | 1 => norm_num [zudilinB, zudilinSolution]
      | k + 2 =>
        have hk := ih k (by omega)
        have hk₁ := ih (k + 1) (by omega)
        have hBk : 0 ≤ zudilinB k := le_trans (by norm_num) hk.1
        have hBk₂ : 0 ≤ zudilinB (k + 2) :=
          le_trans (le_trans (by norm_num) hk₁.1) hk₁.2
        constructor
        · exact hk₁.1.trans hk₁.2
        · rw [zudilinB_rec.step k]
          have hmain :
              zudilinB (k + 2) ≤
                (zAlpha k + zBeta k) * zudilinB (k + 2) := by
            simpa only [one_mul] using
              mul_le_mul_of_nonneg_right (one_le_zAlpha_add_zBeta k) hBk₂
          have hbeta :
              zBeta k * zudilinB (k + 2) ≤
                zBeta k * zudilinB (k + 1) :=
            mul_le_mul_of_nonpos_left hk₁.2 (zBeta_nonpos k)
          have hgamma : 0 ≤ zGamma k * zudilinB k :=
            mul_nonneg (zGamma_nonneg k) hBk
          calc
            zudilinB (k + 2) ≤
                (zAlpha k + zBeta k) * zudilinB (k + 2) := hmain
            _ = zAlpha k * zudilinB (k + 2)
                  + zBeta k * zudilinB (k + 2) := by ring
            _ ≤ zAlpha k * zudilinB (k + 2)
                  + zBeta k * zudilinB (k + 1) :=
              add_le_add (le_refl _) hbeta
            _ ≤ zAlpha k * zudilinB (k + 2)
                  + zBeta k * zudilinB (k + 1)
                  + zGamma k * zudilinB k :=
              le_add_of_nonneg_right hgamma

theorem zudilinB_thirty_one_mul_le (n : ℕ) :
    31 * zudilinB (n + 2) ≤ zudilinB (n + 3) := by
  rw [zudilinB_rec.step n]
  have hBn : 0 ≤ zudilinB n :=
    le_trans (by norm_num) (zudilinB_one_le_and_le_succ n).1
  have hBn₂ : 0 ≤ zudilinB (n + 2) :=
    le_trans (by norm_num) (zudilinB_one_le_and_le_succ (n + 2)).1
  have hmain :
      31 * zudilinB (n + 2) ≤
        (zAlpha n + zBeta n) * zudilinB (n + 2) :=
    mul_le_mul_of_nonneg_right
      (thirty_one_le_zAlpha_add_zBeta n) hBn₂
  have hbeta :
      zBeta n * zudilinB (n + 2) ≤
        zBeta n * zudilinB (n + 1) :=
    mul_le_mul_of_nonpos_left
      (zudilinB_one_le_and_le_succ (n + 1)).2 (zBeta_nonpos n)
  have hgamma : 0 ≤ zGamma n * zudilinB n :=
    mul_nonneg (zGamma_nonneg n) hBn
  calc
    31 * zudilinB (n + 2) ≤
        (zAlpha n + zBeta n) * zudilinB (n + 2) := hmain
    _ = zAlpha n * zudilinB (n + 2)
          + zBeta n * zudilinB (n + 2) := by ring
    _ ≤ zAlpha n * zudilinB (n + 2)
          + zBeta n * zudilinB (n + 1) :=
      add_le_add (le_refl _) hbeta
    _ ≤ zAlpha n * zudilinB (n + 2)
          + zBeta n * zudilinB (n + 1)
          + zGamma n * zudilinB n :=
      le_add_of_nonneg_right hgamma

theorem gaugeScalar_shift_one {v : ℕ → ℚ} (hv : ZudilinSatisfiesRec v)
    (n : ℕ) :
    gaugeScalar v (n + 1) = twist n * gaugeRow1 v n := by
  rw [gaugeScalar, gaugeRow1, twist_succ, hv.step]
  simp only [Nat.add_comm, Nat.add_left_comm]
  linear_combination
    twist n * v (n + 2) * gauge_bottom_col0 n
      + twist n * v (n + 1) * gauge_bottom_col1 n
      + twist n * v n * gauge_bottom_col2 n

theorem gaugeScalar_shift_two {v : ℕ → ℚ} (hv : ZudilinSatisfiesRec v)
    (n : ℕ) :
    gaugeScalar v (n + 2) = twist n * gaugeRow0 v n := by
  rw [show n + 2 = (n + 1) + 1 by omega, gaugeScalar_shift_one hv,
    gaugeRow1, twist_succ, hv.step]
  simp only [gaugeRow0, Nat.add_comm, Nat.add_left_comm]
  linear_combination
    twist n * v (n + 2) * gauge_middle_col0 n
      + twist n * v (n + 1) * gauge_middle_col1 n
      + twist n * v n * gauge_middle_col2 n

theorem gaugeScalar_step {v : ℕ → ℚ} (hv : ZudilinSatisfiesRec v)
    (n : ℕ) :
    gaugeScalar v (n + 3) =
      pAlpha n * gaugeScalar v (n + 2)
        + pBeta n * gaugeScalar v (n + 1)
        + pGamma n * gaugeScalar v n := by
  have h₃ :
      gaugeScalar v (n + 3) =
        twist n
          * (pAlpha n * gaugeRow0 v n + pBeta n * gaugeRow1 v n
            + pGamma n * gaugeRow2 v n) := by
    rw [show n + 3 = (n + 1) + 2 by omega, gaugeScalar_shift_two hv,
      gaugeRow0, twist_succ, hv.step]
    simp only [gaugeRow0, gaugeRow1, gaugeRow2, Nat.add_comm,
      Nat.add_left_comm]
    linear_combination
      twist n * v (n + 2) * gauge_top_col0 n
        + twist n * v (n + 1) * gauge_top_col1 n
        + twist n * v n * gauge_top_col2 n
  rw [h₃, gaugeScalar_shift_two hv n, gaugeScalar_shift_one hv n]
  simp only [gaugeScalar, gaugeRow2]
  ring

theorem gaugeScalar_scaledRec {v : ℕ → ℚ} (hv : ZudilinSatisfiesRec v) :
    ScaledSatisfiesRec (gaugeScalar v) := by
  intro n
  rw [gaugeScalar_step hv, pAlpha_eq, pBeta_eq, pGamma_eq]
  ring

def gaugeScale : ℚ := 223729 / 1755433451520

