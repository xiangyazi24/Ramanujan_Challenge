/-! ## Analytic transfer from Zudilin's source approximants -/

def zeta3 : ℝ := ∑' n : ℕ, (1 : ℝ) / (n + 1) ^ 3

def zudilinBReal (n : ℕ) : ℝ := (zudilinB n : ℝ)
def zudilinB₂Real (n : ℕ) : ℝ := (zudilinB₂ n : ℝ)
def zudilinB₃Real (n : ℕ) : ℝ := (zudilinB₃ n : ℝ)
