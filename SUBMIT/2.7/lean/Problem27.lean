/-
  Ramanujan Challenge Problem 2.7: a four-term recurrence for ζ(2) + ζ(3).

  The challenge gives the rational recurrence

    u_{n+1} = (B_n / A_n) u_n
      - (C_{n-1} / A_{n-1}) u_{n-1}
      + (D_{n-2} / A_{n-2}) u_{n-2},                 n ≥ 2,

  together with three initial values for each of p and q.

  This file formalizes those coefficients, the two uniquely determined
  rational sequences, and the exact rational gauge from Zudilin's source
  recurrence.  The gauge identities, initial-value matching, coefficient
  limits, and analytic transfer are kernel-checked.  The final theorem exposes
  only Zudilin's source asymptotics as hypotheses; the desired challenge limit
  is not assumed.
-/
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import Mathlib.Analysis.Polynomial.Basic
import Mathlib.Tactic.ComputeDegree

open Filter Topology
open scoped Polynomial

noncomputable section

namespace RamanujanChallenge.P27

/-! ## The challenge coefficients -/

def A (n : ℕ) : ℚ :=
  1024 * (2 * n + 5) ^ 4 * (2 * n + 7) ^ 3 * (2 * n + 9) ^ 3
    * (946 * n ^ 2 + 6407 * n + 10860)

def B (n : ℕ) : ℚ :=
  128 * (2 * n + 7) ^ 3 * (2 * n + 9) ^ 3
    * (104060 * n ^ 6 + 1745370 * n ^ 5 + 12145238 * n ^ 4
      + 44886481 * n ^ 3 + 92943995 * n ^ 2 + 102256019 * n + 46709052)

def C (n : ℕ) : ℚ :=
  16 * (n + 3) ^ 4 * (2 * n + 9) ^ 3
    * (3784 * n ^ 5 + 57792 * n ^ 4 + 351019 * n ^ 3
      + 1059230 * n ^ 2 + 1587211 * n + 944620)

def D (n : ℕ) : ℚ :=
  (n + 3) ^ 4 * (n + 4) ^ 6 * (946 * n ^ 2 + 4515 * n + 5399)

/-- The Problem 2.7 recurrence, reindexed by `n = k + 2` so no truncated
subtraction occurs in its formal statement. -/
def SatisfiesRec (u : ℕ → ℚ) : Prop :=
  ∀ k : ℕ,
    u (k + 3) =
      B (k + 2) / A (k + 2) * u (k + 2)
        - C (k + 1) / A (k + 1) * u (k + 1)
        + D k / A k * u k

/-! ## The two challenge sequences -/

/-- The unique sequence generated by the challenge recurrence from three
initial values. -/
def solution (u₀ u₁ u₂ : ℚ) : ℕ → ℚ
  | 0 => u₀
  | 1 => u₁
  | 2 => u₂
  | n + 3 =>
      B (n + 2) / A (n + 2) * solution u₀ u₁ u₂ (n + 2)
        - C (n + 1) / A (n + 1) * solution u₀ u₁ u₂ (n + 1)
        + D n / A n * solution u₀ u₁ u₂ n

def challengeP : ℕ → ℚ :=
  solution (-612218384750) (-9525021973931919 / 18100)
    (-29561828382772029 / 65380)

def challengeQ : ℕ → ℚ :=
  solution (-215040420000) (-167282265043404 / 905)
    (-964185327658080 / 6071)

theorem solution_satisfiesRec (u₀ u₁ u₂ : ℚ) :
    SatisfiesRec (solution u₀ u₁ u₂) :=
  fun _ => rfl

theorem challengeP_rec : SatisfiesRec challengeP :=
  solution_satisfiesRec _ _ _

theorem challengeQ_rec : SatisfiesRec challengeQ :=
  solution_satisfiesRec _ _ _

/-! ## Initial values and a forward recurrence check -/

theorem challengeP_zero : challengeP 0 = -612218384750 := rfl
theorem challengeP_one : challengeP 1 = -9525021973931919 / 18100 := rfl
theorem challengeP_two : challengeP 2 = -29561828382772029 / 65380 := rfl

theorem challengeQ_zero : challengeQ 0 = -215040420000 := rfl
theorem challengeQ_one : challengeQ 1 = -167282265043404 / 905 := rfl
theorem challengeQ_two : challengeQ 2 = -964185327658080 / 6071 := rfl

theorem challengeP_three :
    challengeP 3 = -96756337931563198337 / 249098976 := by
  norm_num [challengeP, solution, A, B, C, D]

theorem challengeQ_three :
    challengeQ 3 = -5619291355848500 / 41187 := by
  norm_num [challengeQ, solution, A, B, C, D]

/-! ## Uniqueness

This prevents the recurrence formalization from denoting an unrelated pair of
sequences: any rational sequences with the challenge's initial values and
recurrence are definitionally forced to be `challengeP` and `challengeQ`.
-/

theorem eq_of_satisfiesRec {u v : ℕ → ℚ}
    (hu : SatisfiesRec u) (hv : SatisfiesRec v)
    (h₀ : u 0 = v 0) (h₁ : u 1 = v 1) (h₂ : u 2 = v 2) :
    u = v := by
  funext m
  induction m using Nat.strong_induction_on with
  | h m ih =>
      match m with
      | 0 => exact h₀
      | 1 => exact h₁
      | 2 => exact h₂
      | k + 3 =>
        rw [hu k, hv k, ih (k + 2) (by omega), ih (k + 1) (by omega),
          ih k (by omega)]

theorem challengeP_eq_of_initial_and_rec {p : ℕ → ℚ}
    (hp : SatisfiesRec p)
    (h₀ : p 0 = -612218384750)
    (h₁ : p 1 = -9525021973931919 / 18100)
    (h₂ : p 2 = -29561828382772029 / 65380) :
    p = challengeP :=
  eq_of_satisfiesRec hp challengeP_rec h₀ h₁ h₂

theorem challengeQ_eq_of_initial_and_rec {q : ℕ → ℚ}
    (hq : SatisfiesRec q)
    (h₀ : q 0 = -215040420000)
    (h₁ : q 1 = -167282265043404 / 905)
    (h₂ : q 2 = -964185327658080 / 6071) :
    q = challengeQ :=
  eq_of_satisfiesRec hq challengeQ_rec h₀ h₁ h₂

/-- Faithful kernel-checked characterization of both sequences appearing in
Problem 2.7.  In particular, the witnesses are not arbitrary constant
sequences: they have the challenge's six initial values and satisfy its
four-term recurrence at every index. -/
theorem problem27_challenge_sequences :
    SatisfiesRec challengeP ∧ SatisfiesRec challengeQ
      ∧ challengeP 0 = -612218384750
      ∧ challengeP 1 = -9525021973931919 / 18100
      ∧ challengeP 2 = -29561828382772029 / 65380
      ∧ challengeQ 0 = -215040420000
      ∧ challengeQ 1 = -167282265043404 / 905
      ∧ challengeQ 2 = -964185327658080 / 6071 := by
  exact ⟨challengeP_rec, challengeQ_rec, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-! ## Zudilin's source recurrence

The source is Theorem 2 of W. Zudilin, *Approximations to -, di- and
tri-logarithms* (arXiv:math/0409023).  Its denominator `zudilinA` is the
coefficient of `v (k+3)` after putting the paper's index `n = k+2`.
-/

def zudilinQ (n : ℕ) : ℚ := 946 * n ^ 2 - 731 * n + 153

def zudilinM (n : ℕ) : ℚ :=
  104060 * n ^ 6 + 127710 * n ^ 5 + 12788 * n ^ 4 - 34525 * n ^ 3
    - 8482 * n ^ 2 + 3298 * n + 1071

def zudilinN (n : ℕ) : ℚ :=
  3784 * n ^ 5 - 1032 * n ^ 4 - 1925 * n ^ 3 + 853 * n ^ 2
    + 328 * n - 184

def zudilinR (n : ℕ) : ℚ := 946 * n ^ 2 + 1161 * n + 368

def zudilinA (n : ℕ) : ℚ :=
  zudilinQ n * (2 * n + 1) * (n + 1) ^ 3

def ZudilinSatisfiesRec (v : ℕ → ℚ) : Prop :=
  ∀ k : ℕ,
    v (k + 3) =
      zudilinM (k + 2) / zudilinA (k + 2) * v (k + 2)
        - (k + 2) * zudilinN (k + 2) / zudilinA (k + 2) * v (k + 1)
        + zudilinR (k + 2) * (k + 2) * (k + 1) ^ 3
            / (2 * zudilinA (k + 2)) * v k

def zudilinSolution (v₀ v₁ v₂ : ℚ) : ℕ → ℚ
  | 0 => v₀
  | 1 => v₁
  | 2 => v₂
  | k + 3 =>
      zudilinM (k + 2) / zudilinA (k + 2) * zudilinSolution v₀ v₁ v₂ (k + 2)
        - (k + 2) * zudilinN (k + 2) / zudilinA (k + 2)
            * zudilinSolution v₀ v₁ v₂ (k + 1)
        + zudilinR (k + 2) * (k + 2) * (k + 1) ^ 3
            / (2 * zudilinA (k + 2)) * zudilinSolution v₀ v₁ v₂ k

def zudilinB : ℕ → ℚ := zudilinSolution 1 7 163
def zudilinB₂ : ℕ → ℚ := zudilinSolution 0 (23 / 2) (2145 / 8)
def zudilinB₃ : ℕ → ℚ := zudilinSolution 0 (17 / 2) (3135 / 16)
def zudilinM23 (n : ℕ) : ℚ := zudilinB₂ n + zudilinB₃ n

theorem zudilinSolution_rec (v₀ v₁ v₂ : ℚ) :
    ZudilinSatisfiesRec (zudilinSolution v₀ v₁ v₂) :=
  fun _ => rfl

theorem zudilinB_rec : ZudilinSatisfiesRec zudilinB :=
  zudilinSolution_rec _ _ _

theorem zudilinB₂_rec : ZudilinSatisfiesRec zudilinB₂ :=
  zudilinSolution_rec _ _ _

theorem zudilinB₃_rec : ZudilinSatisfiesRec zudilinB₃ :=
  zudilinSolution_rec _ _ _

theorem ZudilinSatisfiesRec.add {v w : ℕ → ℚ}
    (hv : ZudilinSatisfiesRec v) (hw : ZudilinSatisfiesRec w) :
    ZudilinSatisfiesRec (fun n => v n + w n) := by
  intro k
  simp only []
  linear_combination hv k + hw k

theorem zudilinM23_rec : ZudilinSatisfiesRec zudilinM23 :=
  zudilinB₂_rec.add zudilinB₃_rec

/-! ## The exact scalar gauge

Only the third row of the `3 × 3` rational gauge is needed to recover the
scalar challenge sequences.  We divide the accompanying proof's gauge by the harmless
nonzero constant `1755433451520 / 223729`; this turns the three leading
coefficients into `-13281/64`, `47/8`, and `-1`.
-/

def gaugeQ71 (n : ℕ) : ℚ :=
  n ^ 2 + (71 / 22) * n + 225 / 86

def gaugeQ105 (n : ℕ) : ℚ :=
  n ^ 2 + (105 / 22) * n + 5399 / 946

def gaugeQ115 (n : ℕ) : ℚ :=
  n ^ 2 + (115 / 22) * n + 3237 / 473

def gaugeQ149 (n : ℕ) : ℚ :=
  n ^ 2 + (149 / 22) * n + 5430 / 473

def gaugeQ193 (n : ℕ) : ℚ :=
  n ^ 2 + (193 / 22) * n + 18213 / 946

def gaugeQ237 (n : ℕ) : ℚ :=
  n ^ 2 + (237 / 22) * n + 13729 / 473

def gaugeDen (n : ℕ) : ℚ :=
  (n + 3) ^ 3 * gaugeQ71 n * gaugeQ105 n

def gaugeCommon (n : ℕ) : ℚ := (n + 7 / 2) * (n + 5 / 2) ^ 2

def gaugeP20 (n : ℕ) : ℚ :=
  n ^ 4 + 8 * n ^ 3 + (1260571 / 53124) * n ^ 2
    + (410587 / 13281) * n + 793741 / 53124

def gaugeP21 (n : ℕ) : ℚ :=
  n ^ 2 + 3 * n + 110 / 47

def gaugeR20 (n : ℕ) : ℚ :=
  (-13281 / 64) * gaugeCommon n * gaugeP20 n / gaugeDen n

def gaugeR21 (n : ℕ) : ℚ :=
  (47 / 8) * gaugeCommon n * (n + 3 / 2) * (n + 2)
    * gaugeP21 n / gaugeDen n

def gaugeR22 (n : ℕ) : ℚ :=
  -gaugeCommon n * (n + 2) * (n + 1) ^ 3 / gaugeDen n

def twistRatio (n : ℕ) : ℚ :=
  (n + 4) ^ 3 / ((n + 5 / 2) * (n + 7 / 2) * (n + 9 / 2))

def twist : ℕ → ℚ
  | 0 => 1
  | n + 1 => twistRatio n * twist n

theorem twist_succ (n : ℕ) : twist (n + 1) = twistRatio n * twist n := rfl

/-- The third row of the scaled rational gauge, with its common
hypergeometric twist. -/
def gaugeScalar (v : ℕ → ℚ) (n : ℕ) : ℚ :=
  twist n * (gaugeR20 n * v (n + 2) + gaugeR21 n * v (n + 1) + gaugeR22 n * v n)

/-- Recurrence for `x_n = 64^n u_n`. -/
def ScaledSatisfiesRec (x : ℕ → ℚ) : Prop :=
  ∀ k : ℕ,
    x (k + 3) =
      64 * B (k + 2) / A (k + 2) * x (k + 2)
        - 64 ^ 2 * C (k + 1) / A (k + 1) * x (k + 1)
        + 64 ^ 3 * D k / A k * x k

theorem A_pos (n : ℕ) : 0 < A n := by
  simp only [A]
  positivity

theorem gaugeQ71_pos (n : ℕ) : 0 < gaugeQ71 n := by
  simp only [gaugeQ71]
  positivity

theorem gaugeQ105_pos (n : ℕ) : 0 < gaugeQ105 n := by
  simp only [gaugeQ105]
  positivity

theorem gaugeQ115_pos (n : ℕ) : 0 < gaugeQ115 n := by
  simp only [gaugeQ115]
  positivity

theorem gaugeQ149_pos (n : ℕ) : 0 < gaugeQ149 n := by
  simp only [gaugeQ149]
  positivity

theorem gaugeQ193_pos (n : ℕ) : 0 < gaugeQ193 n := by
  simp only [gaugeQ193]
  positivity

theorem gaugeQ237_pos (n : ℕ) : 0 < gaugeQ237 n := by
  simp only [gaugeQ237]
  positivity

theorem gaugeDen_pos (n : ℕ) : 0 < gaugeDen n := by
  simp only [gaugeDen]
  exact mul_pos (mul_pos (by positivity) (gaugeQ71_pos n)) (gaugeQ105_pos n)

theorem gaugeR21_nonneg (n : ℕ) : 0 ≤ gaugeR21 n := by
  rw [gaugeR21]
  apply div_nonneg
  · simp only [gaugeCommon, gaugeP21]
    positivity
  · exact le_of_lt (gaugeDen_pos n)

theorem gaugeR22_nonpos (n : ℕ) : gaugeR22 n ≤ 0 := by
  rw [gaugeR22]
  apply div_nonpos_of_nonpos_of_nonneg
  · exact mul_nonpos_of_nonpos_of_nonneg
      (mul_nonpos_of_nonpos_of_nonneg
        (neg_nonpos.mpr (by simp only [gaugeCommon]; positivity))
        (by positivity))
      (by positivity)
  · exact le_of_lt (gaugeDen_pos n)

theorem zudilinQ_pos (n : ℕ) : 0 < zudilinQ (n + 2) := by
  simp only [zudilinQ]
  push_cast
  nlinarith [sq_nonneg (n : ℚ)]

theorem zudilinA_pos (n : ℕ) : 0 < zudilinA (n + 2) := by
  simp only [zudilinA]
  exact mul_pos (mul_pos (zudilinQ_pos n) (by positivity)) (by positivity)

def zAlpha (n : ℕ) : ℚ :=
  zudilinM (n + 2) / zudilinA (n + 2)

def zBeta (n : ℕ) : ℚ :=
  -(n + 2) * zudilinN (n + 2) / zudilinA (n + 2)

def zGamma (n : ℕ) : ℚ :=
  zudilinR (n + 2) * (n + 2) * (n + 1) ^ 3
    / (2 * zudilinA (n + 2))

theorem zudilinN_nonneg (n : ℕ) : 0 ≤ zudilinN (n + 2) := by
  simp only [zudilinN]
  push_cast
  ring_nf
  positivity

theorem zudilinR_nonneg (n : ℕ) : 0 ≤ zudilinR (n + 2) := by
  simp only [zudilinR]
  positivity

theorem zBeta_nonpos (n : ℕ) : zBeta n ≤ 0 := by
  simp only [zBeta]
  exact div_nonpos_of_nonpos_of_nonneg
    (mul_nonpos_of_nonpos_of_nonneg
      (neg_nonpos.mpr (by positivity)) (zudilinN_nonneg n))
    (le_of_lt (zudilinA_pos n))

theorem zGamma_nonneg (n : ℕ) : 0 ≤ zGamma n := by
  simp only [zGamma]
  exact div_nonneg
    (mul_nonneg
      (mul_nonneg (zudilinR_nonneg n) (by positivity)) (by positivity))
    (mul_nonneg (by norm_num) (le_of_lt (zudilinA_pos n)))

theorem one_le_zAlpha_add_zBeta (n : ℕ) :
    1 ≤ zAlpha n + zBeta n := by
  rw [zAlpha, zBeta]
  rw [← add_div]
  apply (le_div_iff₀ (zudilinA_pos n)).mpr
  simp only [one_mul]
  simp only [zudilinM, zudilinN, zudilinA, zudilinQ]
  push_cast
  ring_nf
  have hn : (0 : ℚ) ≤ n := by positivity
  nlinarith [pow_nonneg hn 2, pow_nonneg hn 3, pow_nonneg hn 4,
    pow_nonneg hn 5, pow_nonneg hn 6]

theorem thirty_one_le_zAlpha_add_zBeta (n : ℕ) :
    31 ≤ zAlpha n + zBeta n := by
  rw [zAlpha, zBeta]
  rw [← add_div]
  apply (le_div_iff₀ (zudilinA_pos n)).mpr
  simp only [zudilinM, zudilinN, zudilinA, zudilinQ]
  push_cast
  ring_nf
  have hn : (0 : ℚ) ≤ n := by positivity
  nlinarith [pow_nonneg hn 2, pow_nonneg hn 3, pow_nonneg hn 4,
    pow_nonneg hn 5, pow_nonneg hn 6]

