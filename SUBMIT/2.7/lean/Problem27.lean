def gaugeRow2Real (v : ℕ → ℚ) (n : ℕ) : ℝ := (gaugeRow2 v n : ℝ)

theorem one_le_zudilinBReal (n : ℕ) : 1 ≤ zudilinBReal n := by
  change (1 : ℝ) ≤ ((zudilinB n : ℚ) : ℝ)
  exact_mod_cast (zudilinB_one_le_and_le_succ n).1

theorem zudilinBReal_le_succ (n : ℕ) :
    zudilinBReal n ≤ zudilinBReal (n + 1) := by
  change ((zudilinB n : ℚ) : ℝ) ≤ ((zudilinB (n + 1) : ℚ) : ℝ)
  exact_mod_cast (zudilinB_one_le_and_le_succ n).2

theorem zudilinBReal_thirty_one_mul_le (n : ℕ) :
    31 * zudilinBReal (n + 2) ≤ zudilinBReal (n + 3) := by
  change
    (31 : ℝ) * ((zudilinB (n + 2) : ℚ) : ℝ) ≤
      ((zudilinB (n + 3) : ℚ) : ℝ)
  exact_mod_cast zudilinB_thirty_one_mul_le n

theorem zudilinBReal_add_two_tendsto_atTop :
    Tendsto (fun n => zudilinBReal (n + 2)) atTop atTop := by
  apply tendsto_atTop_of_geom_le (c := 31)
  · norm_num [zudilinBReal, zudilinB, zudilinSolution]
  · norm_num
  · exact zudilinBReal_thirty_one_mul_le

theorem gaugeRow2Real_zudilinB_tendsto_atBot :
    Tendsto (gaugeRow2Real zudilinB) atTop atBot := by
  have hR20 :
      ∀ᶠ n in atTop, (gaugeR20 n : ℝ) ≤ -200 :=
    (gaugeR20_tendsto.eventually_lt_const (by norm_num)).mono
      fun _ hn => hn.le
  have hR21 :
      ∀ᶠ n in atTop, (gaugeR21 n : ℝ) ≤ 10 :=
    (gaugeR21_tendsto.eventually_lt_const (by norm_num)).mono
      fun _ hn => hn.le
  have hbound :
      ∀ᶠ n in atTop,
        gaugeRow2Real zudilinB n ≤ -190 * zudilinBReal (n + 2) := by
    filter_upwards [hR20, hR21] with n h20 h21
    have hB0 : 0 ≤ zudilinBReal n :=
      le_trans (by norm_num) (one_le_zudilinBReal n)
    have hB1 : 0 ≤ zudilinBReal (n + 1) :=
      le_trans (by norm_num) (one_le_zudilinBReal (n + 1))
    have hB2 : 0 ≤ zudilinBReal (n + 2) :=
      le_trans (by norm_num) (one_le_zudilinBReal (n + 2))
    have hB12 : zudilinBReal (n + 1) ≤ zudilinBReal (n + 2) :=
      zudilinBReal_le_succ (n + 1)
    have h20mul :
        (gaugeR20 n : ℝ) * zudilinBReal (n + 2) ≤
          -200 * zudilinBReal (n + 2) :=
      mul_le_mul_of_nonneg_right h20 hB2
    have h21mul :
        (gaugeR21 n : ℝ) * zudilinBReal (n + 1) ≤
          10 * zudilinBReal (n + 2) := by
      calc
        (gaugeR21 n : ℝ) * zudilinBReal (n + 1) ≤
            10 * zudilinBReal (n + 1) :=
          mul_le_mul_of_nonneg_right h21 hB1
        _ ≤ 10 * zudilinBReal (n + 2) :=
          mul_le_mul_of_nonneg_left hB12 (by norm_num)
    have hR22 : (gaugeR22 n : ℝ) ≤ 0 := by
      exact_mod_cast gaugeR22_nonpos n
    have h22mul :
        (gaugeR22 n : ℝ) * zudilinBReal n ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg hR22 hB0
    simp only [zudilinBReal] at h20mul h21mul h22mul
    simp only [gaugeRow2Real, gaugeRow2, zudilinBReal]
    push_cast
    linarith
  have hminor :
      Tendsto (fun n => -190 * zudilinBReal (n + 2)) atTop atBot :=
    Tendsto.const_mul_atTop_of_neg (by norm_num)
      zudilinBReal_add_two_tendsto_atTop
  exact tendsto_atBot_mono' atTop hbound hminor

/-- If a denominator is uniformly at least one, convergence of the exact
linear-form error implies convergence of the associated rational
approximants. -/
theorem ratio_tendsto_of_error_tendsto
    (b m : ℕ → ℝ) (L : ℝ)
    (hb : ∀ n, 1 ≤ b n)
    (hError : Tendsto (fun n => L * b n - m n) atTop (𝓝 0)) :
    Tendsto (fun n => m n / b n) atTop (𝓝 L) := by
  have hinvBound :
      IsBoundedUnder (· ≤ ·) atTop (norm ∘ fun n => (b n)⁻¹) := by
    apply isBoundedUnder_of_eventually_le (a := 1)
    exact Eventually.of_forall fun n => by
      have hbpos : 0 < b n := lt_of_lt_of_le zero_lt_one (hb n)
      rw [Function.comp_apply, Real.norm_eq_abs, abs_inv, abs_of_pos hbpos]
      exact (inv_le_one₀ hbpos).2 (hb n)
  have hErrorDiv :
      Tendsto (fun n => (L * b n - m n) / b n) atTop (𝓝 0) := by
    have h := hinvBound.smul_tendsto_zero hError
    simpa only [smul_eq_mul, div_eq_mul_inv, mul_comm] using h
  have h :
      Tendsto
        (fun n : ℕ => L - (L * b n - m n) / b n)
        atTop (𝓝 (L - 0)) :=
    tendsto_const_nhds.sub hErrorDiv
  simp only [sub_zero] at h
  refine h.congr' (Eventually.of_forall fun n => ?_)
  have hb0 : b n ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one (hb n))
  field_simp [hb0]
  ring

theorem twistRatio_pos (n : ℕ) : 0 < twistRatio n := by
  simp only [twistRatio]
  positivity

theorem twist_pos : ∀ n : ℕ, 0 < twist n
  | 0 => by norm_num [twist]
  | n + 1 => by
      rw [twist_succ]
      exact mul_pos (twistRatio_pos n) (twist_pos n)

theorem challenge_ratio_eq_gaugeRow2 (n : ℕ) :
    (challengeP n : ℝ) / (challengeQ n : ℝ) =
      gaugeRow2Real zudilinM23 n / gaugeRow2Real zudilinB n := by
  rw [← congrFun gaugeUnscaled_zudilinM23_eq_challengeP n,
    ← congrFun gaugeUnscaled_zudilinB_eq_challengeQ n]
  simp only [gaugeUnscaled, gaugeScalar, gaugeRow2Real, gaugeRow2]
