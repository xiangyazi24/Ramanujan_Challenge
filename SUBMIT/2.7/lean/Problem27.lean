/-- A nonzero one-step ratio limit determines the corresponding two-step
ratio limit.  This removes one of the four asymptotic assumptions in the
earlier transfer statement. -/
theorem tendsto_two_step_ratio_of_tendsto_step_ratio
    {b : ℕ → ℝ} {μ : ℝ} (hμ : μ ≠ 0)
    (h :
      Tendsto (fun n => b (n + 1) / b n) atTop (𝓝 μ)) :
    Tendsto (fun n => b (n + 2) / b n) atTop (𝓝 (μ ^ 2)) := by
  have hshift :
      Tendsto (fun n => b (n + 2) / b (n + 1)) atTop (𝓝 μ) := by
    simpa only [Nat.add_assoc, Nat.reduceAdd] using
      (tendsto_add_atTop_iff_nat 1).mpr h
  have hmiddle : ∀ᶠ n in atTop, b (n + 1) ≠ 0 :=
    h.eventually_ne hμ |>.mono fun _ hn => (div_ne_zero_iff.mp hn).1
  have hprod :
      Tendsto
        (fun n =>
          (b (n + 2) / b (n + 1)) * (b (n + 1) / b n))
        atTop (𝓝 (μ ^ 2)) := by
    simpa only [pow_two] using hshift.mul h
  refine hprod.congr' ?_
  filter_upwards [hmiddle] with n hn
  field_simp [hn]

/-- The two source limits actually used by the rational gauge: the dominant
denominator step ratio and the combined `ζ(2) + ζ(3)` approximation ratio. -/
def zudilinSourceRatios (n : ℕ) : ℝ × ℝ :=
  (zudilinBReal (n + 1) / zudilinBReal n,
    zudilinM23Real n / zudilinBReal n)

/-- Zudilin's combined exact linear-form error for `ζ(2) + ζ(3)`. -/
def zudilinCombinedError (n : ℕ) : ℝ :=
  (Real.pi ^ 2 / 6 + zeta3) * zudilinBReal n - zudilinM23Real n

def zudilinZeta2Error (n : ℕ) : ℝ :=
  (Real.pi ^ 2 / 6) * zudilinBReal n - zudilinB₂Real n

def zudilinZeta3Error (n : ℕ) : ℝ :=
  zeta3 * zudilinBReal n - zudilinB₃Real n

theorem zudilinCombinedError_eq_add (n : ℕ) :
    zudilinCombinedError n =
      zudilinZeta2Error n + zudilinZeta3Error n := by
  simp only [zudilinCombinedError, zudilinZeta2Error, zudilinZeta3Error,
    zudilinBReal, zudilinB₂Real, zudilinB₃Real, zudilinM23Real,
    zudilinM23]
  push_cast
  ring

/-- Exact analytic transfer through the rational gauge.  The source input has
only the two independent limits that the proof uses; the two-step denominator
limit is derived above, and the numerator enters only through the sum of
Zudilin's two companions. -/
theorem problem27_of_source_ratios
    (μ L : ℝ) (hμ : 1 ≤ μ)
    (hB :
      Tendsto
        (fun n => zudilinBReal (n + 1) / zudilinBReal n)
        atTop (𝓝 μ))
    (hM :
      Tendsto
        (fun n => zudilinM23Real n / zudilinBReal n)
        atTop (𝓝 L)) :
    Tendsto
      (fun n => (challengeP n : ℝ) / (challengeQ n : ℝ))
      atTop (𝓝 L) := by
  let K : ℝ := (-13281 / 64) * μ ^ 2 + (47 / 8) * μ - 1
  have hμ0 : μ ≠ 0 := by linarith
  have hμ20 : μ ^ 2 ≠ 0 := pow_ne_zero _ hμ0
  have hKneg : K < 0 := by
    have hsq : μ ≤ μ ^ 2 := by nlinarith
    dsimp only [K]
    nlinarith
  have hK0 : K ≠ 0 := ne_of_lt hKneg

  have hB₂ :
      Tendsto
        (fun n => zudilinBReal (n + 2) / zudilinBReal n)
        atTop (𝓝 (μ ^ 2)) :=
    tendsto_two_step_ratio_of_tendsto_step_ratio hμ0 hB
  have hM₁ :
      Tendsto
        (fun n => zudilinM23Real (n + 1) / zudilinBReal (n + 1))
        atTop (𝓝 L) :=
    (tendsto_add_atTop_iff_nat 1).mpr hM
  have hM₂ :
      Tendsto
        (fun n => zudilinM23Real (n + 2) / zudilinBReal (n + 2))
        atTop (𝓝 L) :=
    (tendsto_add_atTop_iff_nat 2).mpr hM

  have hquot₁_ne :
      ∀ᶠ n in atTop, zudilinBReal (n + 1) / zudilinBReal n ≠ 0 :=
    hB.eventually_ne hμ0
  have hquot₂_ne :
      ∀ᶠ n in atTop, zudilinBReal (n + 2) / zudilinBReal n ≠ 0 :=
    hB₂.eventually_ne hμ20
  have hB0_ne : ∀ᶠ n in atTop, zudilinBReal n ≠ 0 :=
    hquot₁_ne.mono fun _ h => (div_ne_zero_iff.mp h).2
  have hB1_ne : ∀ᶠ n in atTop, zudilinBReal (n + 1) ≠ 0 :=
    hquot₁_ne.mono fun _ h => (div_ne_zero_iff.mp h).1
  have hB2_ne : ∀ᶠ n in atTop, zudilinBReal (n + 2) ≠ 0 :=
    hquot₂_ne.mono fun _ h => (div_ne_zero_iff.mp h).1

  have hdenExpr :
      Tendsto
        (fun n =>
          (gaugeR20 n : ℝ) * (zudilinBReal (n + 2) / zudilinBReal n)
            + (gaugeR21 n : ℝ) * (zudilinBReal (n + 1) / zudilinBReal n)
            + (gaugeR22 n : ℝ))
        atTop (𝓝 K) := by
    have h :=
      ((gaugeR20_tendsto.mul hB₂).add (gaugeR21_tendsto.mul hB)).add
        gaugeR22_tendsto
    simpa only [K] using h
  have hden :
      Tendsto
        (fun n => gaugeRow2Real zudilinB n / zudilinBReal n)
        atTop (𝓝 K) := by
    refine hdenExpr.congr' ?_
    filter_upwards [hB0_ne] with n hn
    have hn' : ((zudilinB n : ℚ) : ℝ) ≠ 0 := by
      simpa only [zudilinBReal] using hn
    simp only [gaugeRow2Real, gaugeRow2, zudilinBReal]
    push_cast
    field_simp [hn']

  have hnumExpr :
      Tendsto
        (fun n =>
          (gaugeR20 n : ℝ)
              * ((zudilinM23Real (n + 2) / zudilinBReal (n + 2))
                * (zudilinBReal (n + 2) / zudilinBReal n))
            + (gaugeR21 n : ℝ)
              * ((zudilinM23Real (n + 1) / zudilinBReal (n + 1))
                * (zudilinBReal (n + 1) / zudilinBReal n))
            + (gaugeR22 n : ℝ)
              * (zudilinM23Real n / zudilinBReal n))
        atTop (𝓝 (L * K)) := by
    have h :=
      ((gaugeR20_tendsto.mul (hM₂.mul hB₂)).add
        (gaugeR21_tendsto.mul (hM₁.mul hB))).add
          (gaugeR22_tendsto.mul hM)
    have hval :
        (-13281 / 64) * (L * μ ^ 2) + (47 / 8) * (L * μ)
            + (-1) * L =
          L * K := by
      dsimp only [K]
      ring
    rw [hval] at h
    exact h
  have hnum :
      Tendsto
        (fun n => gaugeRow2Real zudilinM23 n / zudilinBReal n)
        atTop (𝓝 (L * K)) := by
    refine hnumExpr.congr' ?_
    filter_upwards [hB0_ne, hB1_ne, hB2_ne] with n h0 h1 h2
    have h0' : ((zudilinB n : ℚ) : ℝ) ≠ 0 := by
      simpa only [zudilinBReal] using h0
    have h1' : ((zudilinB (n + 1) : ℚ) : ℝ) ≠ 0 := by
      simpa only [zudilinBReal] using h1
    have h2' : ((zudilinB (n + 2) : ℚ) : ℝ) ≠ 0 := by
      simpa only [zudilinBReal] using h2
    simp only [gaugeRow2Real, gaugeRow2, zudilinM23Real, zudilinBReal]
    push_cast
    field_simp [h0', h1', h2']

  have hnormalized := hnum.div hden hK0
  have hLK : L * K / K = L := by
    field_simp [hK0]
  rw [hLK] at hnormalized
  have hcore :
      Tendsto
        (fun n =>
          gaugeRow2Real zudilinM23 n / gaugeRow2Real zudilinB n)
        atTop (𝓝 L) := by
    refine hnormalized.congr' ?_
    filter_upwards [hB0_ne] with n hn
    change
      (gaugeRow2Real zudilinM23 n / zudilinBReal n)
          / (gaugeRow2Real zudilinB n / zudilinBReal n) =
        gaugeRow2Real zudilinM23 n / gaugeRow2Real zudilinB n
    field_simp [hn]
  refine hcore.congr' (Eventually.of_forall fun n => ?_)
  exact (challenge_ratio_eq_gaugeRow2 n).symm

/-- Strong analytic transfer: decay of the single combined Zudilin linear
form is enough.  No asymptotic for the denominator ratio is required.  The
exact recurrence proves geometric growth of `zudilinB`, and the limiting
gauge coefficients then force the transformed denominator to tend to
negative infinity. -/
theorem problem27_of_source_error
    (L : ℝ)
    (hError :
      Tendsto
        (fun n => L * zudilinBReal n - zudilinM23Real n)
        atTop (𝓝 0)) :
    Tendsto
      (fun n => (challengeP n : ℝ) / (challengeQ n : ℝ))
      atTop (𝓝 L) := by
  let E : ℕ → ℝ := fun n => L * zudilinBReal n - zudilinM23Real n
  have hE : Tendsto E atTop (𝓝 0) := by
    simpa only [E] using hError
  have hE₁ : Tendsto (fun n => E (n + 1)) atTop (𝓝 0) :=
    (tendsto_add_atTop_iff_nat 1).mpr hE
  have hE₂ : Tendsto (fun n => E (n + 2)) atTop (𝓝 0) :=
    (tendsto_add_atTop_iff_nat 2).mpr hE
  have hGaugeError :
      Tendsto
        (fun n =>
          (gaugeR20 n : ℝ) * E (n + 2)
            + (gaugeR21 n : ℝ) * E (n + 1)
            + (gaugeR22 n : ℝ) * E n)
        atTop (𝓝 0) := by
    simpa only [mul_zero, add_zero] using
      ((gaugeR20_tendsto.mul hE₂).add
        (gaugeR21_tendsto.mul hE₁)).add
          (gaugeR22_tendsto.mul hE)
  have hDenInv :
      Tendsto
        (fun n => (gaugeRow2Real zudilinB n)⁻¹)
        atTop (𝓝 0) :=
    tendsto_inv_atBot_zero.comp gaugeRow2Real_zudilinB_tendsto_atBot
  have hErrorRatio :
      Tendsto
        (fun n =>
          ((gaugeR20 n : ℝ) * E (n + 2)
              + (gaugeR21 n : ℝ) * E (n + 1)
              + (gaugeR22 n : ℝ) * E n)
            / gaugeRow2Real zudilinB n)
        atTop (𝓝 0) := by
    simpa only [div_eq_mul_inv, mul_zero] using hGaugeError.mul hDenInv
  have hLimit :
      Tendsto
        (fun n =>
          L -
            ((gaugeR20 n : ℝ) * E (n + 2)
                + (gaugeR21 n : ℝ) * E (n + 1)
                + (gaugeR22 n : ℝ) * E n)
              / gaugeRow2Real zudilinB n)
        atTop (𝓝 L) := by
    simpa only [sub_zero] using tendsto_const_nhds.sub hErrorRatio
  have hDenNeg :
      ∀ᶠ n in atTop, gaugeRow2Real zudilinB n < 0 :=
    (tendsto_atBot.mp gaugeRow2Real_zudilinB_tendsto_atBot (-1)).mono
      fun _ hn => hn.trans_lt (by norm_num)
  refine hLimit.congr' ?_
  filter_upwards [hDenNeg] with n hn
  rw [challenge_ratio_eq_gaugeRow2]
  have hden0 : gaugeRow2Real zudilinB n ≠ 0 := ne_of_lt hn
  simp only [gaugeRow2Real, gaugeRow2] at hden0
  push_cast at hden0
  simp only [E, gaugeRow2Real, gaugeRow2, zudilinBReal,
    zudilinM23Real]
  push_cast
  field_simp [hden0, Nat.add_comm]
  ring

/-- Problem 2.7 from the equivalent joint source-ratio limit. -/
theorem problem27_zeta2_add_zeta3_of_joint_ratios
    (μ : ℝ) (hμ : 1 ≤ μ)
    (hSource :
      Tendsto zudilinSourceRatios atTop
        (𝓝 (μ, Real.pi ^ 2 / 6 + zeta3))) :
    Tendsto
      (fun n => (challengeP n : ℝ) / (challengeQ n : ℝ))
      atTop (𝓝 (Real.pi ^ 2 / 6 + zeta3)) := by
  apply problem27_of_source_ratios μ (Real.pi ^ 2 / 6 + zeta3) hμ
  · simpa only [zudilinSourceRatios] using hSource.fst_nhds
  · simpa only [zudilinSourceRatios] using hSource.snd_nhds

/-- Problem 2.7 from the single analytic input stated by Zudilin's
hypergeometric construction: the combined exact linear-form error tends to
zero.  All denominator growth and noncancellation needed by the gauge are
proved in this file from the exact recurrence. -/
theorem problem27_zeta2_add_zeta3
    (hError : Tendsto zudilinCombinedError atTop (𝓝 0)) :
    Tendsto
      (fun n => (challengeP n : ℝ) / (challengeQ n : ℝ))
      atTop (𝓝 (Real.pi ^ 2 / 6 + zeta3)) := by
  apply problem27_of_source_error (Real.pi ^ 2 / 6 + zeta3)
  simpa only [zudilinCombinedError] using hError

/-- Direct interface to the two error estimates printed in Zudilin's
Theorem 2. -/
theorem problem27_zeta2_add_zeta3_of_zudilin_errors
    (hZeta2Error : Tendsto zudilinZeta2Error atTop (𝓝 0))
    (hZeta3Error : Tendsto zudilinZeta3Error atTop (𝓝 0)) :
    Tendsto
      (fun n => (challengeP n : ℝ) / (challengeQ n : ℝ))
      atTop (𝓝 (Real.pi ^ 2 / 6 + zeta3)) := by
  apply problem27_zeta2_add_zeta3
  have heq :
      zudilinCombinedError =
        fun n => zudilinZeta2Error n + zudilinZeta3Error n :=
    funext zudilinCombinedError_eq_add
  rw [heq]
  simpa only [add_zero] using hZeta2Error.add hZeta3Error

/-- Backwards-compatible decomposition of the joint source asymptotic into
Zudilin's two separately named approximation ratios.  No independent
two-step denominator hypothesis is needed. -/
theorem problem27_zeta2_add_zeta3_of_separate_limits
    (μ : ℝ) (hμ : 1 ≤ μ)
    (hB :
      Tendsto
        (fun n => zudilinBReal (n + 1) / zudilinBReal n)
        atTop (𝓝 μ))
    (hZeta2 :
      Tendsto
        (fun n => zudilinB₂Real n / zudilinBReal n)
        atTop (𝓝 (Real.pi ^ 2 / 6)))
    (hZeta3 :
      Tendsto
        (fun n => zudilinB₃Real n / zudilinBReal n)
        atTop (𝓝 zeta3)) :
    Tendsto
      (fun n => (challengeP n : ℝ) / (challengeQ n : ℝ))
      atTop (𝓝 (Real.pi ^ 2 / 6 + zeta3)) := by
  have hM :
      Tendsto
        (fun n => zudilinM23Real n / zudilinBReal n)
        atTop (𝓝 (Real.pi ^ 2 / 6 + zeta3)) := by
    have h := hZeta2.add hZeta3
    have heq :
        (fun n => zudilinM23Real n / zudilinBReal n) =
          (fun n =>
            zudilinB₂Real n / zudilinBReal n
              + zudilinB₃Real n / zudilinBReal n) := by
      funext n
      simp only [zudilinM23Real, zudilinBReal, zudilinB₂Real,
        zudilinB₃Real, zudilinM23]
      push_cast
      ring
    rw [heq]
    exact h
  exact problem27_of_source_ratios μ _ hμ hB hM

end RamanujanChallenge.P27

