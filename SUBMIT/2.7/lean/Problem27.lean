/-! ## Limits of the rational gauge coefficients -/

def gaugePolyQ71 : ℝ[X] :=
  Polynomial.X ^ 2 + Polynomial.C (71 / 22) * Polynomial.X
    + Polynomial.C (225 / 86)

def gaugePolyQ105 : ℝ[X] :=
  Polynomial.X ^ 2 + Polynomial.C (105 / 22) * Polynomial.X
    + Polynomial.C (5399 / 946)

def gaugePolyCommon : ℝ[X] :=
  (Polynomial.X + Polynomial.C (7 / 2))
    * (Polynomial.X + Polynomial.C (5 / 2)) ^ 2

def gaugePolyP20 : ℝ[X] :=
  Polynomial.X ^ 4 + Polynomial.C 8 * Polynomial.X ^ 3
    + Polynomial.C (1260571 / 53124) * Polynomial.X ^ 2
