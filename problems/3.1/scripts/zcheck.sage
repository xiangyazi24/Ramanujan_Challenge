R.<a> = PolynomialRing(QQ)
falpha = (a^12 - 3*a^11 + 4*a^10 - 5*a^9 + 6*a^8 - 7*a^7
          + 7*a^6 - 7*a^5 + 6*a^4 - 5*a^3 + 4*a^2 - 3*a + 1)
K.<aa> = NumberField(falpha, embedding=RealField(200)("0.590989428670256"))

# the palindromic field has a natural index-2 subfield generated by a + 1/a
u = aa + 1/aa
fu = u.minpoly()
print("a + 1/a  minpoly degree:", fu.degree())
print("   ", fu)

t  = aa^(-4)
nu = (t - 1) * (1 - aa) / (aa*t + 1)
Z  = nu^2 - (t + 1/t - 2)*nu + 2
fZ = Z.minpoly()
print()
print("Z minpoly degree:", fZ.degree())
print("   ", fZ)
print()
print("Is Z in Q(a + 1/a)?")
L.<uu> = NumberField(fu, embedding=RealField(200)(u))
try:
    zin = L(Z) if Z in L else None
except Exception:
    zin = None
# more robust: check whether Q(Z) == Q(u) by comparing the subfields
KZ = K.subfield(Z)[0]
KU = K.subfield(u)[0]
print("  deg Q(Z) =", KZ.degree(), "   deg Q(a+1/a) =", KU.degree())
print("  Q(Z) isomorphic to Q(a+1/a):", KZ.is_isomorphic(KU))

# is Z fixed by the palindromic involution a -> 1/a ?
print()
print("palindromic involution check:")
# a -> 1/a is an automorphism of K since falpha is palindromic
auts = K.automorphisms()
print("  |Aut(K/Q)| =", len(auts))
inv = None
for s in auts:
    if s(aa) == 1/aa:
        inv = s
if inv is None:
    print("  a -> 1/a is NOT a field automorphism of K")
else:
    print("  found the involution a -> 1/a")
    print("  inv(Z) == Z ?", inv(Z) == Z)
    print("  (a trace of a real representation should be fixed by it)")

# totally real?
print()
print("K signature:", K.signature(), " (r1,r2); totally real means r2=0")
print("Q(Z) signature:", KZ.signature())
print("Q(a+1/a) signature:", KU.signature())
